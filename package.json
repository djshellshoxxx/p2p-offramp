{
  "name": "p2p-offramp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import ./scripts/test-support/register-tsx.mjs --test --test-concurrency=4 packages/*/test/*.test.mjs apps/web/test/*.test.mjs scripts/tests/research-evidence.test.mjs scripts/tests/npm-registry-signatures.test.mjs",
    "test:specs": "python -m unittest discover -s scripts/tests -v",
    "test:evm": "cd contracts/evm && forge test",
    "test:evm:local": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-local-trade.mjs",
    "test:exchange:evm": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-exchange-evm-local.mjs",
    "test:payment:preflight": "node --test scripts/tests/fixture-receipt.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-payment-preflight-local.mjs",
    "test:locator:browser": "node scripts/test-release-locator-browser.mjs",
    "test:chat:browser": "node scripts/test-chat-history-browser.mjs",
    "test:diagnostics:browser": "node scripts/test-diagnostics-browser.mjs",
    "test:backup:browser": "node scripts/test-backup-verification-browser.mjs",
    "test:update:runtime:browser": "node --test scripts/tests/update-attempts.test.mjs && node scripts/test-update-runtime-browser.mjs",
    "test:recovery:browser": "node scripts/test-recovery-references-browser.mjs",
    "test:recovery:evm": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/evm-recovery.test.mjs scripts/tests/evm-recovery-endpoint-options.test.mjs scripts/tests/sepolia-release-assets.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-recovery-local.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-recovery-releases-local.mjs",
    "acceptance:report": "node scripts/acceptance-report.mjs",
    "test:acceptance:cli": "node --test scripts/tests/acceptance-entry.test.mjs",
    "test:evm:reconcile": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-reconcile-local.mjs",
    "test:evm:viem": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/viem-read-rpc.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-viem-oracle-local.mjs",
    "test:sepolia:kit": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/sepolia-hygiene.test.mjs scripts/tests/deployment-record.test.mjs scripts/tests/sepolia-deployment-ids.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-sepolia-kit-local.mjs",
    "test:sepolia:trade": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/sepolia-trade-state.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-sepolia-trade-local.mjs",
    "sepolia:deploy": "node --import ./scripts/test-support/register-tsx.mjs scripts/sepolia/deploy.mjs",
    "sepolia:verify": "node --import ./scripts/test-support/register-tsx.mjs scripts/sepolia/verify-release.mjs",
    "sepolia:trade": "node --import ./scripts/test-support/register-tsx.mjs scripts/sepolia/trade.mjs",
    "abi:evm": "bash contracts/evm/script/export-abi.sh",
    "check:specs": "python scripts/spec_audit.py --check",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.runtime.json --noEmit && tsc -p apps/web/tsconfig.worker.json --noEmit && tsc -p apps/web/tsconfig.ui.json --noEmit",
    "test:browser": "node scripts/test-vault-browser.mjs && node scripts/test-runtime-browser.mjs && node scripts/test-content-policy-browser.mjs && node scripts/test-reseal-crash-browser.mjs && node scripts/test-lifecycle-tabs-browser.mjs",
    "build": "npm run typecheck && node apps/web/scripts/build.mjs",
    "build:demo": "npm run typecheck && node apps/web/scripts/build.mjs demo",
    "build:testnet": "npm run typecheck && node apps/web/scripts/build.mjs testnet",
    "build:localnet": "node apps/web/scripts/build.mjs localnet",
    "check:docs": "node --import ./scripts/test-support/register-tsx.mjs scripts/docs/validate.mjs",
    "test:reputation:intake": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/reputation/semaphore-v4-evaluation.test.mjs",
    "test:tooling": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/docs/validate.test.mjs scripts/lab/recipe.test.mjs scripts/tests/tool-path.test.mjs scripts/portal/build.test.mjs scripts/distribution/stage.test.mjs scripts/tests/refresh-evidence-manifest.test.mjs scripts/tests/governance-main-ancestry.test.mjs scripts/tests/update-attempts.test.mjs",
    "test:portal:browser": "node scripts/test-scriptless-portal-browser.mjs",
    "test:distribution:browser": "node scripts/distribution/browser.test.mjs",
    "check:governance": "node --import ./scripts/test-support/register-tsx.mjs scripts/governance/check-all.mjs && node scripts/governance/refresh-evidence-manifest.mjs --check",
    "test:web:browser": "node scripts/test-web-build-browser.mjs && node scripts/test-trade-review-browser.mjs && node scripts/test-saved-reviews-browser.mjs && node scripts/test-testnet-build-browser.mjs && npm run test:qr:browser",
    "test:templates:browser": "node scripts/test-trade-templates-browser.mjs",
    "test:favorites:browser": "node scripts/test-saved-review-favorites-browser.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "test:build-policy": "node --test apps/web/scripts/artifact-policy.test.mjs apps/web/scripts/scan-build.test.mjs apps/web/scripts/source-locale.test.mjs scripts/tests/import-boundaries.test.mjs scripts/tests/verify-web-artifact.test.mjs apps/web/scripts/qr-build-policy.test.mjs",
    "test:diagnostics": "node --test scripts/tests/capture-labels.test.mjs",
    "test:fuzz": "node --test scripts/tests/evm-agreement-fuzz.test.mjs",
    "test:private:browser": "node scripts/test-g16-browser.mjs && node scripts/test-g16-adapter-browser.mjs && node scripts/test-g16-physical-browser.mjs && node scripts/test-release-browser.mjs",
    "test:escrow": "npm --prefix packages/escrow-evm test",
    "test:local-evm": "node scripts/test-local-evm.mjs",
    "test:locale:browser": "node scripts/test-locale-layout-browser.mjs",
    "test:research:receipts": "node --test scripts/tests/research-evidence.test.mjs",
    "test:peer:browser": "node scripts/test-peer-replay-browser.mjs",
    "test:relay:native": "node --import ./scripts/test-support/register-tsx.mjs --test --test-concurrency=1 scripts/tests/nostr-relay-native.test.mjs",
    "test:localnet:controller": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-localnet-controller.mjs",
    "test:localnet:browser": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-localnet-browser.mjs",
    "test:localnet:erc20": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-localnet-erc20.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-localnet-erc20-independent.mjs",
    "test:localnet:erc20:browser": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-localnet-erc20-browser.mjs",
    "test:formal:unit": "node --test scripts/tests/formal-evm.test.mjs",
    "test:qr:browser": "node scripts/test-qr-browser.mjs",
    "test:solana:browser": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-solana-localnet-browser.mjs",
    "test:solana:ack:browser": "node scripts/test-solana-withheld-send-browser.mjs",
    "test:solana:restore:browser": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-solana-restore-browser.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nostr-tools": "2.25.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "viem": "2.57.10",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "jsqr": "1.4.0"
  }
}
