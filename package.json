{
  "name": "p2p-offramp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs apps/web/test/*.test.mjs",
    "test:specs": "python -m unittest discover -s scripts/tests -v",
    "check:specs": "python scripts/spec_audit.py --check",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.runtime.json --noEmit && tsc -p apps/web/tsconfig.worker.json --noEmit",
    "test:browser": "node scripts/test-vault-browser.mjs && node scripts/test-runtime-browser.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/curves": "2.4.0"
  }
}
