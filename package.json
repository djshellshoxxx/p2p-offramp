{
  "name": "p2p-offramp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import ./scripts/test-support/register-tsx.mjs --test packages/*/test/*.test.mjs apps/web/test/*.test.mjs",
    "test:specs": "python -m unittest discover -s scripts/tests -v",
    "test:evm": "cd contracts/evm && forge test",
    "test:evm:local": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-local-trade.mjs",
    "test:exchange:evm": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-exchange-evm-local.mjs",
    "test:payment:preflight": "node --test scripts/tests/fixture-receipt.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-payment-preflight-local.mjs",
    "test:locator:browser": "node scripts/test-release-locator-browser.mjs",
    "test:chat:browser": "node scripts/test-chat-history-browser.mjs",
    "test:diagnostics:browser": "node scripts/test-diagnostics-browser.mjs",
    "test:recovery:browser": "node scripts/test-recovery-references-browser.mjs",
    "test:recovery:evm": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/evm-recovery.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-recovery-local.mjs",
    "acceptance:report": "node scripts/acceptance-report.mjs",
    "test:acceptance:cli": "node --test scripts/tests/acceptance-entry.test.mjs",
    "test:evm:reconcile": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-evm-reconcile-local.mjs",
    "test:sepolia:kit": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/sepolia-hygiene.test.mjs scripts/tests/deployment-record.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-sepolia-kit-local.mjs",
    "test:sepolia:trade": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/tests/sepolia-trade-state.test.mjs && node --import ./scripts/test-support/register-tsx.mjs scripts/test-sepolia-trade-local.mjs",
    "sepolia:deploy": "node --import ./scripts/test-support/register-tsx.mjs scripts/sepolia/deploy.mjs",
    "sepolia:verify": "node --import ./scripts/test-support/register-tsx.mjs scripts/sepolia/verify-release.mjs",
    "sepolia:trade": "node --import ./scripts/test-support/register-tsx.mjs scripts/sepolia/trade.mjs",
    "abi:evm": "bash contracts/evm/script/export-abi.sh",
    "check:specs": "python scripts/spec_audit.py --check",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.runtime.json --noEmit && tsc -p apps/web/tsconfig.worker.json --noEmit && tsc -p apps/web/tsconfig.ui.json --noEmit",
    "test:browser": "node scripts/test-vault-browser.mjs && node scripts/test-runtime-browser.mjs && node scripts/test-content-policy-browser.mjs && node scripts/test-reseal-crash-browser.mjs && node scripts/test-lifecycle-tabs-browser.mjs",
    "build": "npm run typecheck && node apps/web/scripts/build.mjs",
    "build:demo": "npm run typecheck && node apps/web/scripts/build.mjs demo",
    "build:testnet": "npm run typecheck && node apps/web/scripts/build.mjs testnet",
    "test:web:browser": "node scripts/test-web-build-browser.mjs && node scripts/test-trade-review-browser.mjs && node scripts/test-saved-reviews-browser.mjs && node scripts/test-testnet-build-browser.mjs && npm run test:favorites:browser && npm run test:share:browser",
    "test:favorites:browser": "node scripts/test-review-favorites-browser.mjs",
    "test:share:browser": "node scripts/test-generic-app-share-browser.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "test:build-policy": "node --test apps/web/scripts/artifact-policy.test.mjs apps/web/scripts/scan-build.test.mjs apps/web/scripts/source-locale.test.mjs scripts/tests/import-boundaries.test.mjs",
    "test:diagnostics": "node --test scripts/tests/capture-labels.test.mjs",
    "test:fuzz": "node --test scripts/tests/evm-agreement-fuzz.test.mjs",
    "test:private:browser": "node scripts/test-g16-browser.mjs && node scripts/test-g16-adapter-browser.mjs && node scripts/test-g16-physical-browser.mjs && node scripts/test-release-browser.mjs",
    "test:escrow": "npm --prefix packages/escrow-evm test",
    "test:local-evm": "node scripts/test-local-evm.mjs",
    "test:locale:browser": "node scripts/test-locale-layout-browser.mjs",
    "build:portal": "node scripts/portal/build.mjs",
    "test:portal:browser": "node scripts/test-scriptless-portal-browser.mjs",
    "check:docs": "node --import ./scripts/test-support/register-tsx.mjs scripts/docs/validate.mjs",
    "check:governance": "node --import ./scripts/test-support/register-tsx.mjs scripts/governance/check-all.mjs",
    "test:completion:tools": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/portal/build.test.mjs scripts/docs/validate.test.mjs scripts/lab/recipe.test.mjs scripts/tests/formal-evm.test.mjs scripts/reputation/semaphore-v4-evaluation.test.mjs scripts/tests/refresh-evidence-manifest.test.mjs && npm run check:docs && npm run check:governance",
    "test:eip1271:local": "node --import ./scripts/test-support/register-tsx.mjs scripts/test-eip1271-local.mjs",
    "test:journey:browser": "node scripts/test-journey-browser.mjs",
    "test:journey:origins": "node scripts/test-journey-origin-browser.mjs",
    "stage:distribution": "node --import ./scripts/test-support/register-tsx.mjs scripts/distribution/stage.mjs",
    "test:distribution": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/distribution/stage.test.mjs",
    "test:distribution:browser": "node --import ./scripts/test-support/register-tsx.mjs scripts/distribution/browser.test.mjs",
    "typecheck:optional": "tsc --noEmit -p packages/proof-jobs/tsconfig.worker.json && tsc --noEmit -p packages/proof-jobs/tsconfig.fixture.json && tsc --noEmit -p packages/proof-inputs/tsconfig.json",
    "test:proof:browser": "node --import ./scripts/test-support/register-tsx.mjs packages/proof-jobs/test/browser.mjs",
    "test:proof:memory": "node packages/proof-jobs/test/node-wasm-memory.mjs",
    "test:privacy-controls:browser": "node packages/privacy-controls/test/native-browser.mjs",
    "test:meetup:browser": "node packages/meetup/test/origin-ledger-browser.mjs",
    "test:retention:browser": "node scripts/test-retention-browser.mjs",
    "test:updates:browser": "node scripts/test-release-update-browser.mjs",
    "test:zoom:browser": "node scripts/test-browser-zoom.mjs",
    "test:formal:unit": "node --test scripts/tests/formal-evm.test.mjs",
    "test:reputation:intake": "node --import ./scripts/test-support/register-tsx.mjs --test scripts/reputation/semaphore-v4-evaluation.test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
