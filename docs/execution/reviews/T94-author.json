  "problem": "The new T93 oracle regression class could silently skip in a clean Python CI environment. Host-installed cryptography masked that dependency omission.",
  "change": "Mandatory complete development-only hashed binary closure is installed before the existing tests in both Python/spec CI lanes. Only importlib.util and the optional class skip were removed from the existing test; all four test bodies remain unchanged.",
  "ciLanes": [
    {
      "workflow": ".github/workflows/specifications.yml",
      "job": "inventory",
      "python": "3.12",
      "runner": "ubuntu-latest amd64"
    },
    {
      "workflow": ".github/workflows/vault-foundation.yml",
      "job": "specs",
      "python": "3.12",
      "runner": "ubuntu-latest amd64"
    }
  ],
  "ciInstallCommand": "python -m pip --isolated install --disable-pip-version-check --no-cache-dir --require-hashes --only-binary=:all: -r scripts/tests/requirements-crypto.txt",
